    ),
    include: str | None = typer.Option(
        None,
        "--include",
        help="Comma-separated account ids to uninstall (only these). "
        "Applied before --exclude.",
    ),
    exclude: str | None = typer.Option(
        None,
        "--exclude",
        help="Comma-separated account ids to keep (e.g. ACC-0101-0101,ACC-2222-2222).",
    ),
    dry_run: bool = typer.Option(
        False,
        "--dry-run",
        help="Show which accounts would be uninstalled, without changing anything.",
    ),
    yes: bool = typer.Option(
        False,
        "--yes",
        "-y",
        help="Skip the confirmation prompt.",
    ),
) -> None:
    """Uninstall the extension from the accounts it is installed into.

    Targets the current installations (status Installed). Use --include to
    restrict to specific accounts, and --exclude to keep some (--include first).
    """
    rt = resolve_runtime(ctx.obj)
    include_ids = {
        part.strip() for part in (include or "").split(",") if part.strip()
    }
    exclude_ids = {
        part.strip() for part in (exclude or "").split(",") if part.strip()
    }

    try:
        with console.status("[bold green]Fetching installations…"):
            installations = asyncio.run(
                fetch_all_pages(
                    rt, _format_path(INSTALLATIONS_PATH, rt), parallelism=parallelism
                )
            )
    except (httpx.ConnectError, httpx.TimeoutException) as exc:
        console.print(f"[bold red]Connection error:[/bold red] {exc}")
        raise typer.Exit(1)

    candidates = installations
    if include_ids:
        candidates = [
            i for i in installations if (i.get("account") or {}).get("id") in include_ids
        ]
        present = {(i.get("account") or {}).get("id") for i in installations}
        missing = include_ids - present
        if missing:
            console.print(
                "[yellow]Ignoring --include ids that are not installed:[/yellow] "
                + ", ".join(sorted(missing))
            )

    targets = [
        i for i in candidates if (i.get("account") or {}).get("id") not in exclude_ids
    ]
    skipped = len(candidates) - len(targets)

    if not targets:
        console.print(
            "[green]Nothing to uninstall — no matching installations"
            f"{f' after excluding {skipped}' if skipped else ''}.[/green]"
        )
        return

    if dry_run:
        table = Table(
            title=f"[DRY RUN] Would uninstall {rt.extension_id} from {len(targets)} "
            f"account(s){f', {skipped} excluded' if skipped else ''}",
            box=box.ROUNDED,
            border_style="yellow",
            header_style="bold cyan",
        )
        table.add_column("Account id", style="cyan", no_wrap=True)
        table.add_column("Name", style="white")
        table.add_column("Installation", style="white")
        for inst in targets:
            account = inst.get("account") or {}
            table.add_row(
                _stringify(account.get("id")),
                _stringify(account.get("name")),
                _stringify(inst.get("id")),
            )
        emit_table(table)
        return

    if not yes:
        if not sys.stdin.isatty():
            console.print(
                "[bold red]Refusing to uninstall without confirmation.[/bold red] "
                "Re-run with --yes (or --dry-run to preview)."
            )
            raise typer.Exit(1)
        console.print(
            f"About to uninstall [bold]{rt.extension_id}[/bold] from "
            f"[bold]{len(targets)}[/bold] account(s)"
            f"{f' ({skipped} excluded)' if skipped else ''}."
        )
        typer.confirm("Proceed?", abort=True)

    async def _uninstall_all(
        on_done: Callable[[dict[str, Any]], None] | None,
    ) -> list[dict[str, Any]]:
        return await uninstall_extension_from(
            rt, targets, parallelism=parallelism, on_done=on_done
        )

    try:
        if output is OutputFormat.TABLE:
            with Progress(
                SpinnerColumn(),
                TextColumn("[progress.description]{task.description}"),
                BarColumn(),
                MofNCompleteColumn(),
                TimeElapsedColumn(),
                console=console,
            ) as progress:
                task = progress.add_task(
                    f"Uninstalling {rt.extension_id}", total=len(targets)
                )
                results = asyncio.run(
                    _uninstall_all(lambda _r: progress.advance(task))
                )
        else:
            results = asyncio.run(_uninstall_all(None))
    except (httpx.ConnectError, httpx.TimeoutException) as exc:
        console.print(f"[bold red]Connection error:[/bold red] {exc}")
        raise typer.Exit(1)

    succeeded = [r for r in results if r.get("ok")]
    failed = [r for r in results if not r.get("ok")]

    if output is OutputFormat.JSON:
        emit_json([r["installation"] for r in succeeded])
    else:
        if succeeded:
            table = Table(
                title=f"Uninstalled {rt.extension_id} from {len(succeeded)} account(s)",
                box=box.ROUNDED,
                border_style="green",
                header_style="bold cyan",
            )
            table.add_column("Account id", style="cyan", no_wrap=True)
            table.add_column("Name", style="white")
            table.add_column("Installation", style="white")
            for r in succeeded:
                account = r["account"]
                inst = r.get("installation") or {}
                table.add_row(
                    _stringify(account.get("id")),
                    _stringify(account.get("name")),
                    _stringify(inst.get("id")),
                )
            emit_table(table)
        else:
            console.print("[yellow]No installations were removed.[/yellow]")

    if failed:
        console.print(f"\n[bold red]{len(failed)} account(s) failed:[/bold red]")
        for r in failed:
            console.print(
