def svg_path_to_drawio(path_data: str) -> str:
    """Convert SVG path data to draw.io path commands."""
    import re
    
    drawio_commands = []
    # Parse SVG path commands (simplified parser for common commands)
    commands = re.findall(r'([MLHVCSQTAZ])([^MLHVCSQTAZ]*)', path_data, re.IGNORECASE)
    
    current_x, current_y = 0, 0
    
    for cmd, params in commands:
        params = [float(p) for p in params.replace(',', ' ').split() if p.strip()]
        
        if cmd.upper() == 'M':  # Move
            if len(params) >= 2:
                current_x, current_y = params[0], params[1]
                drawio_commands.append(f'<move x="{params[0]}" y="{params[1]}"/>')
        elif cmd.upper() == 'L':  # Line
            if len(params) >= 2:
                current_x, current_y = params[0], params[1]
                drawio_commands.append(f'<line x="{params[0]}" y="{params[1]}"/>')
        elif cmd.upper() == 'H':  # Horizontal line
            if params:
                current_x = params[0]
                drawio_commands.append(f'<line x="{params[0]}" y="{current_y}"/>')
        elif cmd.upper() == 'V':  # Vertical line
            if params:
                current_y = params[0]
                drawio_commands.append(f'<line x="{current_x}" y="{params[0]}"/>')
        elif cmd.upper() == 'C':  # Cubic Bezier
            if len(params) >= 6:
                current_x, current_y = params[4], params[5]
                drawio_commands.append(f'<curve x1="{params[0]}" y1="{params[1]}" x2="{params[2]}" y2="{params[3]}" x3="{params[4]}" y3="{params[5]}"/>')
        elif cmd.upper() == 'Q':  # Quadratic Bezier
            if len(params) >= 4:
                current_x, current_y = params[2], params[3]
                drawio_commands.append(f'<quad x1="{params[0]}" y1="{params[1]}" x2="{params[2]}" y2="{params[3]}"/>')
        elif cmd.upper() == 'Z':  # Close path
            drawio_commands.append('<close/>')
    
    return '\n            '.join(drawio_commands)


def normalize_coordinate(coord: float, viewbox_min: float, viewbox_size: float, shape_size: float) -> float:
    """Normalize a viewBox coordinate to shape coordinates (0 to shape_size)."""
    return ((coord - viewbox_min) / viewbox_size * shape_size) if viewbox_size != 0 else 0


def parse_length(value: str, default: float = 0.0) -> float:
    if not value:
        return default
    return float(value.replace('px', '').replace('pt', ''))


def encode_for_drawio_url(data_str: str) -> str:
    """
    Encode XML data for draw.io library format with URL encoding.
    Uses pako deflate compression and base64 encoding.
    """
    quoted = urllib.parse.quote(data_str)
    data_bytes = quoted.encode('utf-8')
    compressed = zlib.compress(data_bytes, 9)
    deflated = compressed[2:-4]
    return base64.b64encode(deflated).decode('utf-8')


def create_drawio_css_shape(svg_content: str, title: str, css_mode: str = "preserve") -> tuple[str, float, float]:
    """
    Converts SVG to a draw.io image cell with CSS customization.
    Returns (encoded_mxgraph_xml, width, height)
    """
    svg_root = ET.fromstring(svg_content)

    viewbox = svg_root.get('viewBox', None)
    if viewbox:
        parts = viewbox.split()
        if len(parts) >= 4:
            vb_x, vb_y, vb_width, vb_height = map(float, parts)
        else:
            vb_x, vb_y = 0, 0
            vb_width = parse_length(svg_root.get('width', '100'), 100)
            vb_height = parse_length(svg_root.get('height', '100'), 100)
    else:
        vb_x, vb_y = 0, 0
        vb_width = parse_length(svg_root.get('width', '100'), 100)
        vb_height = parse_length(svg_root.get('height', '100'), 100)

    width = vb_width
    height = vb_height

    # Normalize SVG for CSS color control
    svg_root.set('xmlns', svg_root.get('xmlns', 'http://www.w3.org/2000/svg'))
    svg_root.set('viewBox', f"{vb_x} {vb_y} {vb_width} {vb_height}")
    svg_root.set('width', str(int(width)))
    svg_root.set('height', str(int(height)))

    # Pick a default color from the SVG
    default_color = None
    for elem in svg_root.iter():
        stroke = elem.get('stroke', None)
        if stroke and stroke.lower() != 'none':
            default_color = stroke
            break
        fill = elem.get('fill', None)
        if fill and fill.lower() != 'none':
            default_color = fill
            break
    if not default_color:
        default_color = '#000000'

    if css_mode not in {"preserve", "single"}:
        css_mode = "preserve"

    if css_mode == "single":
        # Wrap all drawable content in a group with CSS class
        group = ET.Element('g', {'class': 'color'})
        children = builtins.list(svg_root)
        svg_root.clear()
        svg_root.set('xmlns', 'http://www.w3.org/2000/svg')
        svg_root.set('viewBox', f"{vb_x} {vb_y} {vb_width} {vb_height}")
        svg_root.set('width', str(int(width)))
        svg_root.set('height', str(int(height)))

        style = ET.SubElement(svg_root, 'style', {'type': 'text/css'})
        style.text = '.color { stroke: currentColor; fill: currentColor; }'

        for child in children:
            if child.tag.endswith('defs'):
                svg_root.append(child)
                continue
            group.append(child)

        for elem in group.iter():
            tag = elem.tag.split('}')[-1]
            if tag in {'path', 'polygon', 'polyline', 'circle', 'rect', 'ellipse', 'line', 'text'}:
                stroke = elem.get('stroke', None)
                if stroke and stroke.lower() != 'none':
                    elem.set('stroke', 'currentColor')
                fill = elem.get('fill', None)
                if fill and fill.lower() != 'none':
                    elem.set('fill', 'currentColor')

        svg_root.append(group)
    else:
        # Preserve original colors
        svg_root.set('xmlns', svg_root.get('xmlns', 'http://www.w3.org/2000/svg'))
        svg_root.set('viewBox', f"{vb_x} {vb_y} {vb_width} {vb_height}")
        svg_root.set('width', str(int(width)))
        svg_root.set('height', str(int(height)))

    svg_xml = ET.tostring(svg_root, encoding='unicode')
    svg_encoded = urllib.parse.quote(svg_xml)

    style_str = (
        'shape=image;editableCssRules=.*;verticalLabelPosition=bottom;'
        'verticalAlign=top;imageAspect=0;aspect=fixed;'
        f'{"color=" + default_color + ";" if css_mode == "single" else ""}'
        f'image=data:image/svg+xml,{svg_encoded}'
    )

    mx_model = (
        '<mxGraphModel><root>'
        '<mxCell id="0"/>'
        '<mxCell id="1" parent="0"/>'
        f'<mxCell id="2" value="" style="{style_str}" vertex="1" parent="1">'
        f'<mxGeometry width="{int(width)}" height="{int(height)}" as="geometry"/>'
        '</mxCell>'
        '</root></mxGraphModel>'
    )

    encoded = encode_for_drawio_url(mx_model)
    return encoded, width, height


def create_drawio_shape(svg_content: str, title: str) -> tuple[str, float, float]:
    """
    Converts SVG to draw.io native shape XML format.
    Returns (shape_xml, width, height)
    """
    try:
        svg_root = ET.fromstring(svg_content)

        def normalize_color(color: str) -> str:
            if not color:
                return "none"
            return color.strip().lower()

        def parse_length(value: str, default: float = 0.0) -> float:
            if not value:
                return default
            return float(value.replace('px', '').replace('pt', ''))

        # Get dimensions and viewBox
        viewbox = svg_root.get('viewBox', None)
        if viewbox:
            parts = viewbox.split()
            if len(parts) >= 4:
                vb_x, vb_y, vb_width, vb_height = map(float, parts)
            else:
                vb_x, vb_y = 0, 0
                vb_width = parse_length(svg_root.get('width', '100'), 100)
                vb_height = parse_length(svg_root.get('height', '100'), 100)
        else:
            vb_x, vb_y = 0, 0
            vb_width = parse_length(svg_root.get('width', '100'), 100)
            vb_height = parse_length(svg_root.get('height', '100'), 100)

        width = vb_width
        height = vb_height

        # Collect unique stroke/fill colors
        stroke_colors = {}
        fill_colors = {}
        stroke_idx = 0
        fill_idx = 0

        def register_color(color_map: dict, color_value: str, prefix: str) -> None:
            nonlocal stroke_idx, fill_idx
            if color_value == 'none':
                return
            if color_value in color_map:
                return
            if prefix == 'stroke':
                stroke_idx += 1
                color_map[color_value] = f"{prefix}Color{stroke_idx}"
            else:
                fill_idx += 1
                color_map[color_value] = f"{prefix}Color{fill_idx}"

        for polygon in svg_root.findall('.//{http://www.w3.org/2000/svg}polygon'):
            register_color(stroke_colors, normalize_color(polygon.get('stroke', '#000000')), 'stroke')
            register_color(fill_colors, normalize_color(polygon.get('fill', 'none')), 'fill')

        for circle in svg_root.findall('.//{http://www.w3.org/2000/svg}circle'):
            register_color(stroke_colors, normalize_color(circle.get('stroke', '#000000')), 'stroke')
            register_color(fill_colors, normalize_color(circle.get('fill', 'none')), 'fill')

        for rect in svg_root.findall('.//{http://www.w3.org/2000/svg}rect'):
            register_color(stroke_colors, normalize_color(rect.get('stroke', 'none')), 'stroke')
            register_color(fill_colors, normalize_color(rect.get('fill', 'none')), 'fill')

        for path in svg_root.findall('.//{http://www.w3.org/2000/svg}path'):
            register_color(stroke_colors, normalize_color(path.get('stroke', 'none')), 'stroke')
            register_color(fill_colors, normalize_color(path.get('fill', 'none')), 'fill')

        for text in svg_root.findall('.//{http://www.w3.org/2000/svg}text'):
            register_color(fill_colors, normalize_color(text.get('fill', 'none')), 'fill')

        # Create shape root
        shape = ET.Element(
            'shape',
            {
                'name': title,
                'w': str(width),
                'h': str(height),
                'aspect': 'variable',
                'strokewidth': 'inherit',
            },
        )

        if stroke_colors:
            shape.set('strokeColorStyles', ' '.join(stroke_colors.values()))
        if fill_colors:
            shape.set('fillColorStyles', ' '.join(fill_colors.values()))

        if stroke_colors or fill_colors:
            style_parts = [f"{name}={color}" for color, name in stroke_colors.items()]
            style_parts += [f"{name}={color}" for color, name in fill_colors.items()]
            shape.set('style', ';'.join(style_parts))

        connections = ET.SubElement(shape, 'connections')
        for name, x, y in (
            ('N', '0.5', '0'),
            ('S', '0.5', '1'),
            ('W', '0', '0.5'),
            ('E', '1', '0.5'),
            ('NW', '0.15', '0.15'),
            ('NE', '0.85', '0.15'),
            ('SE', '0.85', '0.85'),
            ('SW', '0.15', '0.85'),
        ):
            ET.SubElement(connections, 'constraint', {'x': x, 'y': y, 'perimeter': '0', 'name': name})

        ET.SubElement(shape, 'background')
        foreground = ET.SubElement(shape, 'foreground')

        def add_color_tags(stroke: str, fill: str) -> None:
            if stroke != 'none' and stroke in stroke_colors:
                ET.SubElement(foreground, 'strokecolor', {'color': f"${stroke_colors[stroke]}"})
            if fill != 'none' and fill in fill_colors:
                ET.SubElement(foreground, 'fillcolor', {'color': f"${fill_colors[fill]}"})

        # Paths
        for path in svg_root.findall('.//{http://www.w3.org/2000/svg}path'):
            d = path.get('d', '')
            if not d:
                continue
            fill = normalize_color(path.get('fill', 'none'))
            stroke = normalize_color(path.get('stroke', 'none'))
            add_color_tags(stroke, fill)

            path_el = ET.SubElement(foreground, 'path')
            wrapper = ET.fromstring(f"<w>{svg_path_to_drawio(d)}</w>")
            for child in builtins.list(wrapper):
                path_el.append(child)

            if fill != 'none' and stroke != 'none':
                ET.SubElement(foreground, 'fillstroke')
            elif fill != 'none':
                ET.SubElement(foreground, 'fill')
            elif stroke != 'none':
                ET.SubElement(foreground, 'stroke')

        # Polygons
        for polygon in svg_root.findall('.//{http://www.w3.org/2000/svg}polygon'):
            points = polygon.get('points', '')
            if not points:
                continue
            fill = normalize_color(polygon.get('fill', 'none'))
            stroke = normalize_color(polygon.get('stroke', '#000000'))
            numbers = [float(n) for n in points.replace(',', ' ').split() if n.strip()]
            coords = []
            for i in range(0, len(numbers), 2):
                if i + 1 < len(numbers):
                    x = normalize_coordinate(numbers[i], vb_x, vb_width, width)
                    y = normalize_coordinate(numbers[i + 1], vb_y, vb_height, height)
                    coords.append((x, y))
            if not coords:
                continue

            add_color_tags(stroke, fill)
            path_el = ET.SubElement(foreground, 'path')
            ET.SubElement(path_el, 'move', {'x': str(coords[0][0]), 'y': str(coords[0][1])})
            for x, y in coords[1:]:
                ET.SubElement(path_el, 'line', {'x': str(x), 'y': str(y)})
            ET.SubElement(path_el, 'close')

            if fill != 'none' and stroke != 'none':
                ET.SubElement(foreground, 'fillstroke')
            elif fill != 'none':
                ET.SubElement(foreground, 'fill')
            elif stroke != 'none':
                ET.SubElement(foreground, 'stroke')

        # Circles
        for circle in svg_root.findall('.//{http://www.w3.org/2000/svg}circle'):
            cx = normalize_coordinate(float(circle.get('cx', '0')), vb_x, vb_width, width)
            cy = normalize_coordinate(float(circle.get('cy', '0')), vb_y, vb_height, height)
            r = float(circle.get('r', '0')) * width / vb_width if vb_width != 0 else 0
            fill = normalize_color(circle.get('fill', 'white'))
            stroke = normalize_color(circle.get('stroke', '#000000'))
            add_color_tags(stroke, fill)

            ET.SubElement(
                foreground,
                'ellipse',
                {'x': str(cx - r), 'y': str(cy - r), 'w': str(r * 2), 'h': str(r * 2)},
            )

            if fill != 'none' and stroke != 'none':
                ET.SubElement(foreground, 'fillstroke')
            elif fill != 'none':
                ET.SubElement(foreground, 'fill')
            elif stroke != 'none':
                ET.SubElement(foreground, 'stroke')

        # Rectangles
        for rect in svg_root.findall('.//{http://www.w3.org/2000/svg}rect'):
            x = normalize_coordinate(float(rect.get('x', '0')), vb_x, vb_width, width)
            y = normalize_coordinate(float(rect.get('y', '0')), vb_y, vb_height, height)
            w = float(rect.get('width', '0')) * width / vb_width if vb_width != 0 else 0
            h = float(rect.get('height', '0')) * height / vb_height if vb_height != 0 else 0
            fill = normalize_color(rect.get('fill', 'none'))
            stroke = normalize_color(rect.get('stroke', 'none'))
            add_color_tags(stroke, fill)

            ET.SubElement(foreground, 'rect', {'x': str(x), 'y': str(y), 'w': str(w), 'h': str(h)})

            if fill != 'none' and stroke != 'none':
                ET.SubElement(foreground, 'fillstroke')
            elif fill != 'none':
                ET.SubElement(foreground, 'fill')
            elif stroke != 'none':
                ET.SubElement(foreground, 'stroke')

        # Text
        for text in svg_root.findall('.//{http://www.w3.org/2000/svg}text'):
            text_str = (text.text or '').strip()
            if not text_str:
                continue
            x = normalize_coordinate(float(text.get('x', '0')), vb_x, vb_width, width)
            y = normalize_coordinate(float(text.get('y', '0')), vb_y, vb_height, height)
            font_size = parse_length(text.get('font-size', '12'), 12)
            font_family = text.get('font-family', 'Arial')
            text_align = text.get('text-anchor', 'left')
            text_fill = normalize_color(text.get('fill', '#000000'))

            align_map = {'start': 'left', 'middle': 'center', 'end': 'right'}
            align = align_map.get(text_align, 'left')

            y_adjusted = max(0, min(height, y - (font_size * 0.25)))

            ET.SubElement(foreground, 'fontsize', {'size': str(int(font_size))})
            ET.SubElement(foreground, 'fontfamily', {'family': font_family})
            if text_fill != 'none' and text_fill in fill_colors:
                ET.SubElement(foreground, 'fontcolor', {'color': f"${fill_colors[text_fill]}"})
            ET.SubElement(
                foreground,
                'text',
                {
                    'x': str(x),
                    'y': str(y_adjusted),
                    'align': align,
                    'fontsize': str(int(font_size)),
                    'str': text_str,
                },
            )

        shape_xml = ET.tostring(shape, encoding='unicode')
        return shape_xml, width, height

    except ET.ParseError as e:
        console.print(f"[red]Error:[/red] Invalid SVG format: {e}")
        raise typer.Exit(1)
    except Exception as e:
        console.print(f"[red]Error:[/red] Failed to process SVG: {e}")
        raise typer.Exit(1)

def encode_for_drawio(data_str: str) -> str:
    """
    Encode XML data for draw.io library format.
    Uses pako deflate compression and base64 encoding.
    """
    # Encode to UTF-8 bytes
    data_bytes = data_str.encode('utf-8')
    # Compress using zlib (deflate algorithm)
    compressed = zlib.compress(data_bytes, 9)
    # Remove zlib header (2 bytes) and checksum (4 bytes)
    deflated = compressed[2:-4]
    # Base64 encode
    return base64.b64encode(deflated).decode('utf-8')

def load_library(lib_path: Path):
    if not lib_path.exists():
        return []
    try:
        tree = ET.parse(lib_path)
        root = tree.getroot()
        return json.loads(root.text) if root.text else []
    except Exception:
        return []

def save_library(lib_path: Path, shapes: list):
    """Save shapes to library. XML should NOT be escaped in JSON."""
    # First, unescape any XML that might be escaped from previous operations
    for shape in shapes:
        if 'xml' in shape and isinstance(shape['xml'], str):
            # If it looks double-escaped (stored as &lt;shape...), unescape it safely
            if shape['xml'].lstrip().startswith('&lt;shape'):
                shape['xml'] = shape['xml'].replace('&lt;', '<').replace('&gt;', '>').replace('\\"', '"')
    
    library_root = ET.Element("mxlibrary")
    library_root.text = json.dumps(shapes)
    tree = ET.ElementTree(library_root)
    tree.write(lib_path, encoding="utf-8", xml_declaration=True)

@app.callback()
def main(ctx: typer.Context, lib: Path = typer.Option("my_shapes.xml", "--lib", "-l")):
    ctx.obj = lib

@app.command()
def add(
    ctx: typer.Context, 
    svg_path: Path = typer.Argument(...), 
    name: Optional[str] = typer.Option(None, "--name", "-n"),
    mode: str = typer.Option("css", "--mode", "-m", help="native|css"),
    css_mode: str = typer.Option("preserve", "--css-mode", help="preserve|single")
):
    """Adds SVG as a native customizable draw.io shape with full style support."""
    if not svg_path.exists():
        console.print(f"[red]Error:[/red] {svg_path} not found.")
        raise typer.Exit(1)

    lib_path = ctx.obj
    title = name if name else svg_path.stem
    
    # Read SVG content
    with open(svg_path, 'r') as f:
        svg_content = f.read()
    
    # Convert SVG to draw.io shape format
    if mode == "css":
        shape_xml, width, height = create_drawio_css_shape(svg_content, title, css_mode)
    else:
        shape_xml, width, height = create_drawio_shape(svg_content, title)

    shapes = load_library(lib_path)
    shapes = [s for s in shapes if s.get('title') != title]  # Deduplicate

    shapes.append({
        "xml": shape_xml,
        "title": title,
        "w": int(width),
        "h": int(height),
        "aspect": "fixed" if mode == "css" else "variable"
    })

    save_library(lib_path, shapes)
    console.print(f"[bold green]✔[/bold green] Integrated [magenta]{title}[/magenta] into [cyan]{lib_path}[/cyan] as a native shape.")

@app.command()
def list(ctx: typer.Context):
    shapes = load_library(ctx.obj)
    if not shapes:
        console.print("[yellow]Library empty.[/yellow]")
        return
    table = Table(title=f"Library: {ctx.obj}")
    table.add_column("Shape Name")
    for s in shapes:
        table.add_row(s['title'])
    console.print(table)

@app.command()
def remove(ctx: typer.Context, name: str):
    shapes = [s for s in load_library(ctx.obj) if s['title'] != name]
    save_library(ctx.obj, shapes)
    console.print(f"[green]Removed {name}[/green]")

@app.command()
def show(ctx: typer.Context, name: str):
    """Display the XML definition of a shape by its title."""
    shapes = load_library(ctx.obj)
    shape = next((s for s in shapes if s.get('title') == name), None)
    
    if not shape:
        console.print(f"[red]Error:[/red] Shape '{name}' not found in library.")
        raise typer.Exit(1)
    
    xml = shape.get('xml', '')
    if xml.lstrip().startswith('<') or xml.lstrip().startswith('&lt;'):
        xml = xml.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>').replace('\\"', '"')
        print(xml)
        return

    # Attempt to decode compressed mxGraphModel entries
    try:
        raw = base64.b64decode(xml)
        decoded = zlib.decompress(raw, -15).decode('utf-8')
        decoded = urllib.parse.unquote(decoded)
        print(decoded)
    except Exception:
        # Fallback to raw content
        print(xml)

if __name__ == "__main__":
