def _all_spans(spans: List[Span]) -> List[Span]:
    """Recursively get all spans including children"""
    all_spans = []
    for span in spans:
        all_spans.append(span)
        all_spans.extend(_all_spans(span.children))
    return all_spans


def _render_spans_html(spans: List[Span]) -> str:
    """Recursively render spans as HTML tree nodes"""
    if not spans:
        return ""

    parts = []
    for span in spans:
        ts = str(span.timestamp)[:19] if span.timestamp else ""
        failure_class = "" if span.success else " failure"
        status = "✓" if span.success else "✗"

        # Child-tree toggle (only if has children)
        if span.children:
            child_btn = f'<span class="child-toggle" onclick="event.stopPropagation(); toggleChildren(this)">▶</span>'
        else:
            child_btn = '<span class="child-toggle placeholder"></span>'

        # Type badge
        type_badge = f'<span class="badge badge-type">{span.span_type}</span>' if span.span_type else ""

        # Result code badge (red if not 2xx/success)
        if span.result_code:
            rc = str(span.result_code)
            rc_cls = "badge-error" if (not span.success or rc.startswith(("4", "5"))) else "badge-code"
            code_badge = f'<span class="badge {rc_cls}">{rc}</span>'
        else:
            code_badge = ""

        dur = f'<span class="dur">{fmt_duration(span.duration_ms)}</span>'
        ts_span = f'<span class="ts">{ts}</span>' if ts else ""

        # Detail rows
        detail_rows = []
        if span.span_id:
            detail_rows.append(("Span ID", span.span_id))
        if span.operation_id:
            detail_rows.append(("Operation ID", span.operation_id))
        if span.parent_id:
            detail_rows.append(("Parent ID", span.parent_id))
        if ts:
            detail_rows.append(("Timestamp", ts))
        detail_rows.append(("Duration", f"{fmt_duration(span.duration_ms)} ({span.duration_ms:.3f} ms)"))
        if span.span_type:
            detail_rows.append(("Type", span.span_type))
        if span.result_code:
            detail_rows.append(("Result Code", span.result_code))
        if span.message:
            detail_rows.append(("Message", span.message))

        detail_html = "".join(
            f'<div class="detail-row"><span class="detail-key">{k}</span><span class="detail-val">{v}</span></div>'
            for k, v in detail_rows
        )

        children_html = ""
        if span.children:
            children_html = f'<div class="children">{_render_spans_html(span.children)}</div>'

        parts.append(f"""<div class="tree-node">
  <div class="span-row{failure_class}" onclick="toggleDetail(this)">
    {child_btn}
    <span class="status-icon">{'✅' if span.success else '❌'}</span>
    <span class="span-name">{span.span_name}</span>
    <span class="span-meta">{type_badge}{code_badge}{dur}{ts_span}</span>
    <span class="detail-arrow">▼</span>
  </div>
  <div class="span-detail">{detail_html}</div>
  {children_html}
</div>""")

    return "\n".join(parts)


def filename_for(base: str, output_dir: Optional[Path] = None) -> Path:
    """Generate a unique filename for output"""
    today = datetime.now().strftime("%Y%m%d")
    if output_dir is None:
        output_dir = Path(".")
    else:
        output_dir = Path(output_dir)

    output_dir.mkdir(parents=True, exist_ok=True)
    base_name = f"{base}_{today}.html"
    p = output_dir / base_name

    if not p.exists():
        return p

    counter = 1
    while True:
        p2 = output_dir / f"{base}_{today}_{counter}.html"
        if not p2.exists():
            return p2
        counter += 1


@app.command()
def main(
    workspace_id: str = typer.Option(
        ...,
        "--workspace-id",
        "-w",
        help="Azure Log Analytics Workspace ID",
        envvar="AZURE_WORKSPACE_ID",
    ),
    operation_id: Optional[str] = typer.Option(
        None,
        "--operation-id",
        "-o",
        help="Operation ID to fetch traces for",
    ),
    trace_id: Optional[str] = typer.Option(
        None,
        "--trace-id",
        "-t",
        help="Trace ID to fetch spans for",
    ),
    minutes_back: int = typer.Option(
        60,
        "--minutes-back",
        "-m",
        help="How many minutes back to search (default: 60)",
    ),
    output_dir: Optional[Path] = typer.Option(
        None,
        "--output-dir",
        "-d",
        help="Directory to save the HTML file",
    ),
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Enable debug mode to see queries and raw results",
    ),
) -> None:
    """
    Export traces and spans from Azure Application Insights to an interactive HTML treeview.

    Requires AZURE_WORKSPACE_ID environment variable or --workspace-id option.
    Authenticate with 'az login' before running.
    """
    if not operation_id and not trace_id:
        console.print(
            "[red]Error: Must provide either --operation-id or --trace-id[/red]"
        )
        raise typer.Exit(code=1)

    with console.status("[bold green]Connecting to Azure..."):
        client = get_logs_client(workspace_id)

    with console.status("[bold green]Querying Application Insights..."):
        rows = query_traces(
            client,
            workspace_id,
            operation_id=operation_id,
            trace_id=trace_id,
            minutes_back=minutes_back,
            debug=debug,
        )

    if not rows:
        console.print(
            "[yellow]No traces found matching the criteria[/yellow]"
        )
        raise typer.Exit(code=0)

    console.print(f"[green]✓[/green] Found {len(rows)} spans")

    with console.status("[bold green]Processing spans..."):
        spans = parse_spans(rows)
        root_spans = build_span_tree(spans)

    search_id = operation_id or trace_id
    outpath = filename_for(f"trace_{search_id}", output_dir=output_dir)

    with console.status("[bold green]Generating HTML..."):
        generate_html(root_spans, search_id, outpath)

    console.print(f"[green]✓[/green] Wrote trace export to {outpath}")
    console.print(f"[blue]Open in browser:[/blue] file://{outpath.absolute()}")


if __name__ == "__main__":
    app()
