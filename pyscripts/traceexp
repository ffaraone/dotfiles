@dataclass
class Span:
    """Represents a trace span from Application Insights"""
    timestamp: str
    duration_ms: float
    operation_id: str
    parent_id: Optional[str]
    span_id: str
    span_name: str
    success: bool
    result_code: Optional[str] = None
    message: Optional[str] = None
    span_type: Optional[str] = None
    children: List["Span"] = field(default_factory=list)


def get_logs_client(workspace_id: str) -> LogsQueryClient:
    """Create and return an Azure Logs Query client"""
    credential = DefaultAzureCredential()
    return LogsQueryClient(credential)


def fmt_duration(ms: float) -> str:
    """Format milliseconds into a human-readable string."""
    if ms < 1:
        return f"{ms * 1000:.0f}µs"
    if ms < 1000:
        return f"{ms:.1f}ms"
    s = ms / 1000
    if s < 60:
        return f"{s:.2f}".rstrip("0").rstrip(".") + "s"
    m, sec = divmod(s, 60)
    if m < 60:
        return f"{int(m)}m {sec:.1f}s"
    h, min_ = divmod(m, 60)
    return f"{int(h)}h {int(min_)}m {sec:.0f}s"


def query_traces(
    client: LogsQueryClient,
    workspace_id: str,
    operation_id: Optional[str] = None,
    trace_id: Optional[str] = None,
    minutes_back: int = 60,
    debug: bool = False,
) -> List[Dict]:
    """Query Application Insights for traces and spans"""
    end_time = datetime.now(timezone.utc)
    start_time = end_time - timedelta(minutes=minutes_back)

    # Use the App* tables (modern Application Insights schema in Log Analytics workspace)
    search_term = operation_id or trace_id

    kql_query = f"""
    AppRequests
    | union AppDependencies
    | union AppTraces
    | union AppExceptions
    | where TimeGenerated > datetime("{start_time.isoformat()}") and TimeGenerated < datetime("{end_time.isoformat()}")
    | where OperationId == "{search_term}"
    | project
        timestamp = TimeGenerated,
        operation_Id = OperationId,
        operation_ParentId = ParentId,
        id = Id,
        name = Name,
        duration = DurationMs,
        success = Success,
        resultCode = ResultCode,
        message = coalesce(Message, Data, Url, ""),
        type = Type
    | order by timestamp asc
    """

    if debug:
        console.print(f"\n[dim]Query:[/dim]\n{kql_query}\n")
    
    try:
        response = client.query_workspace(
            workspace_id=workspace_id,
            query=kql_query,
            timespan=(start_time, end_time),
        )

        if response.status == LogsQueryStatus.PARTIAL:
            console.print(
                "[yellow]Warning: Query returned partial results[/yellow]"
            )
        elif response.status == LogsQueryStatus.FAILURE:
            console.print("[red]Error: Query failed[/red]")
            return []

        if response.tables and response.tables[0].rows:
            if debug:
                console.print(f"[green]✓ Query successful[/green]")
                console.print(f"[dim]Returned {len(response.tables[0].rows)} rows[/dim]")
                if response.tables[0].columns:
                    console.print(f"[dim]Columns: {', '.join(response.tables[0].columns)}[/dim]")
            return response.tables[0].rows
        else:
            console.print(f"[yellow]No data found for search term: {search_term}[/yellow]")
            return []
            
    except Exception as e:
        error_msg = str(e)
        console.print(f"[red]Error querying logs:[/red] {error_msg}")
        
        if debug:
            console.print(f"\n[dim]Full error:[/dim]\n{e}\n")
        
        console.print(
            "\n[yellow]Troubleshooting:[/yellow]\n"
            "• Verify operation_id is correct\n"
            "• Try increasing --minutes-back (e.g., -m 1440 for 24 hours)\n"
            "• Use --debug for full query details and column info"
        )
        raise typer.Exit(code=1)


def parse_spans(rows: List) -> List[Span]:
    """Parse query results into Span objects"""
    spans = []

    for row in rows:
        # Union queries return varying column counts, handle dynamically
        # Expected order from project: timestamp, operation_Id, operation_ParentId, id, name, 
        # duration, success, resultCode, message, type, itemType
        
        data = {
            "timestamp": row[0] if len(row) > 0 else "",
            "operation_Id": row[1] if len(row) > 1 else "",
            "operation_ParentId": row[2] if len(row) > 2 else None,
            "id": row[3] if len(row) > 3 else "",
            "name": row[4] if len(row) > 4 else "Unknown",
            "duration": row[5] if len(row) > 5 else 0,
            "success": row[6] if len(row) > 6 else False,
            "resultCode": row[7] if len(row) > 7 else None,
            "message": row[8] if len(row) > 8 else None,
            "type": row[9] if len(row) > 9 else "Unknown",
        }
        
        # Handle None and missing values gracefully
        duration_val = data.get("duration") or 0
        try:
            duration_ms = float(duration_val) if duration_val else 0.0
        except (ValueError, TypeError):
            duration_ms = 0.0
        
        # Success field handling
        success = data.get("success", False)
        if success is None:
            success = False
        elif isinstance(success, bool):
            pass
        elif isinstance(success, str):
            success = success.lower() in ("true", "1", "yes")
        else:
            try:
                success = bool(success)
            except (ValueError, TypeError):
                success = False
        
        span = Span(
            timestamp=str(data.get("timestamp", "")),
            duration_ms=duration_ms,
            operation_id=str(data.get("operation_Id", "")),
            parent_id=data.get("operation_ParentId"),
            span_id=str(data.get("id", "")),
            span_name=str(data.get("name", "Unknown")),
            success=success,
            result_code=data.get("resultCode"),
            message=data.get("message"),
            span_type=str(data.get("type", "Unknown")),
        )
        spans.append(span)
    return spans


def build_span_tree(spans: List[Span]) -> List[Span]:
    """Build a hierarchical tree structure from flat spans"""
    span_map = {span.span_id: span for span in spans}
    root_spans = []

    for span in spans:
        if span.parent_id and span.parent_id in span_map:
            parent = span_map[span.parent_id]
            parent.children.append(span)
        else:
            root_spans.append(span)

    return root_spans


