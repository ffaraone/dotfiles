def _all_spans(spans: List[Span]) -> List[Span]:
    """Recursively get all spans including children"""
    all_spans = []
    for span in spans:
        all_spans.append(span)
        all_spans.extend(_all_spans(span.children))
    return all_spans


def _render_spans_html(spans: List[Span], root: bool = True) -> str:
    """Recursively render spans as HTML"""
    if not spans:
        return ""

    html = []
    for span in spans:
        timestamp = span.timestamp[:19] if span.timestamp else ""
        status_class = (
            "span-success" if span.success else "span-failure"
        )
        status_text = "✓" if span.success else "✗"

        toggle = (
            f'<span class="toggle collapsed"></span>'
            if span.children
            else '<span style="display: inline-block; width: 20px;"></span>'
        )

        badges = []
        if span.span_type:
            badges.append(
                f'<span class="badge badge-type">{span.span_type}</span>'
            )
        if span.result_code:
            badges.append(
                f'<span class="badge badge-code">{span.result_code}</span>'
            )

        badges_html = (
            f'<div class="badges">{" ".join(badges)}</div>'
            if badges
            else ""
        )

        duration_badge = (
            f'<span class="duration">{span.duration_ms:.2f}ms</span>'
        )

        message_html = (
            f'<br/><span style="color: #999; font-size: 11px; margin-left: 40px;">{span.message}</span>'
            if span.message
            else ""
        )

        html.append(
            f"""
        <div class="tree-node">
            {toggle}
            <span class="span-info">
                <span class="{status_class}">{status_text}</span>
                <span class="span-name">{span.span_name}</span>
                <span class="span-details">{duration_badge}{timestamp}</span>
            </span>
            {badges_html}
            {message_html}
        """
        )

        if span.children:
            children_html = _render_spans_html(span.children, root=False)
            html.append(
                f'<div class="children">{children_html}</div>'
            )

        html.append("</div>")

    return "".join(html)


def filename_for(base: str, output_dir: Optional[Path] = None) -> Path:
    """Generate a unique filename for output"""
    today = datetime.now().strftime("%Y%m%d")
    if output_dir is None:
        output_dir = Path(".")
    else:
        output_dir = Path(output_dir)

    output_dir.mkdir(parents=True, exist_ok=True)
    base_name = f"{base}_{today}.html"
    p = output_dir / base_name

    if not p.exists():
        return p

    counter = 1
    while True:
        p2 = output_dir / f"{base}_{today}_{counter}.html"
        if not p2.exists():
            return p2
        counter += 1


@app.command()
def main(
    workspace_id: str = typer.Option(
        ...,
        "--workspace-id",
        "-w",
        help="Azure Log Analytics Workspace ID",
        envvar="AZURE_WORKSPACE_ID",
    ),
    operation_id: Optional[str] = typer.Option(
        None,
        "--operation-id",
        "-o",
        help="Operation ID to fetch traces for",
    ),
    trace_id: Optional[str] = typer.Option(
        None,
        "--trace-id",
        "-t",
        help="Trace ID to fetch spans for",
    ),
    minutes_back: int = typer.Option(
        60,
        "--minutes-back",
        "-m",
        help="How many minutes back to search (default: 60)",
    ),
    output_dir: Optional[Path] = typer.Option(
        None,
        "--output-dir",
        "-d",
        help="Directory to save the HTML file",
    ),
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Enable debug mode to see queries and raw results",
    ),
) -> None:
    """
    Export traces and spans from Azure Application Insights to an interactive HTML treeview.

    Requires AZURE_WORKSPACE_ID environment variable or --workspace-id option.
    Authenticate with 'az login' before running.
    """
    if not operation_id and not trace_id:
        console.print(
            "[red]Error: Must provide either --operation-id or --trace-id[/red]"
        )
        raise typer.Exit(code=1)

    with console.status("[bold green]Connecting to Azure..."):
        client = get_logs_client(workspace_id)

    with console.status("[bold green]Querying Application Insights..."):
        rows = query_traces(
            client,
            workspace_id,
            operation_id=operation_id,
            trace_id=trace_id,
            minutes_back=minutes_back,
            debug=debug,
        )

    if not rows:
        console.print(
            "[yellow]No traces found matching the criteria[/yellow]"
        )
        raise typer.Exit(code=0)

    console.print(f"[green]✓[/green] Found {len(rows)} spans")

    with console.status("[bold green]Processing spans..."):
        spans = parse_spans(rows)
        root_spans = build_span_tree(spans)

    search_id = operation_id or trace_id
    outpath = filename_for(f"trace_{search_id}", output_dir=output_dir)

    with console.status("[bold green]Generating HTML..."):
        generate_html(root_spans, search_id, outpath)

    console.print(f"[green]✓[/green] Wrote trace export to {outpath}")
    console.print(f"[blue]Open in browser:[/blue] file://{outpath.absolute()}")


if __name__ == "__main__":
    app()
