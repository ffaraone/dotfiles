@app.command()
def main(
    months: int = typer.Option(
        1,
        "--months",
        "-m",
        min=1,
        max=36,
        help="Number of months to report, ending at the anchor month.",
    ),
    year: int | None = typer.Option(
        None, "--year", help="Anchor year. Defaults to the previous month."
    ),
    month: int | None = typer.Option(
        None, "--month", min=1, max=12, help="Anchor month. Defaults to the previous month."
    ),
    percentage: float = typer.Option(
        4.0, "--percentage", "-p", help="Percentage of the spend that gets billed."
    ),
    currency: str = typer.Option(
        DEFAULT_TARGET_CURRENCY,
        "--currency",
        "-C",
        help="Currency the spend is converted to and billed in.",
    ),
    operations_api_base_url: str = typer.Option(
        DEFAULT_OPERATIONS_API_BASE_URL,
        "--operations-api-base-url",
        help="FinOps operations API base URL.",
    ),
    sub: str = typer.Option(
        DEFAULT_OPERATIONS_SUB, "--sub", help="Subject of the operations API JWT."
    ),
    exchange_rates_base_url: str = typer.Option(
        DEFAULT_EXCHANGE_RATES_BASE_URL,
        "--exchange-rates-base-url",
        help="Exchange rates service base URL.",
    ),
    organization: list[str] = typer.Option(
        [], "--organization", "-o", help="Limit the report to these organization IDs."
    ),
    concurrency: int = typer.Option(
        10, "--concurrency", "-c", min=1, max=50, help="Organizations processed in parallel."
    ),
    output: Path | None = typer.Option(None, "--output", help="Destination .xlsx file."),
) -> None:
    """
    Generate an Excel report with the monthly spend converted to the target currency and
    the billed amount for each organization.
    """
    target_currency = currency.strip().upper()
    if len(target_currency) != 3 or not target_currency.isalpha():
        console.print(f"[red]{currency!r} is not a valid ISO 4217 currency code")
        raise typer.Exit(1)

    today = date.today()
    previous_month = today - relativedelta(months=1)
    anchor_year = year or previous_month.year
    anchor_month = month or previous_month.month
    if (anchor_year, anchor_month) > (today.year, today.month):
        console.print("[red]the billing period cannot be in the future")
        raise typer.Exit(1)

    periods = build_periods(anchor_year, anchor_month, months)
    billed_percentage = Decimal(str(percentage))
    destination = output or Path(f"billing_report_{periods[0]}_{periods[-1]}.xlsx")

    secret = env(SECRET_ENV_VAR)
    rates_token = env(RATES_TOKEN_ENV_VAR)

    console.print(
        Panel(
            f"periods: [bold]{', '.join(str(period) for period in periods)}[/]\n"
            f"billed percentage: [bold]{format_percentage(billed_percentage)}%[/]\n"
            f"target currency: [bold]{target_currency}[/]\n"
            f"operations api: [bold]{operations_api_base_url}[/] (sub {sub})\n"
            f"output: [bold]{destination}[/]",
            title="FinOps billing report",
            border_style="cyan",
        )
    )

    builder = ReportBuilder(
        FFCClient(operations_api_base_url, sub, secret),
        ExchangeRatesClient(exchange_rates_base_url, rates_token, target_currency),
        periods,
        billed_percentage,
        concurrency,
    )

    async def run() -> None:
        try:
            await builder.run(list(organization) or None)
        finally:
            await builder.close()

    try:
        asyncio.run(run())
    except Exception as error:  # incomplete data means no report at all
        console.print(f"[red]failed to fetch the data:[/] {describe_error(error)}")
        console.print("[red]no report generated")
        raise typer.Exit(1) from error

    if not builder.rows:
        console.print("[red]no organization with expenses in the reported periods")
        raise typer.Exit(1)

    write_workbook(
        destination,
        periods,
        builder.rows,
        billed_percentage,
        builder.rates.used_rates,
        builder.skipped,
        target_currency,
    )
    print_summary(periods, builder.rows, billed_percentage, target_currency)
    console.print(f"[green]report written to[/] [bold]{destination.resolve()}[/]")


