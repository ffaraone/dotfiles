def write_title(
    sheet,
    columns: int,
    periods: list[Period],
    currency: str,
    percentage: Decimal,
    text_columns: int | None = None,
) -> None:
    """
    Title banner over ``columns``, above the header row.

    The band is painted over every column but the text is merged over ``text_columns``
    only: on a sheet with frozen columns that keeps the title still while the rest of
    the sheet scrolls under the same, uniform band.
    """
    span = f"{periods[0].label} - {periods[-1].label}" if len(periods) > 1 else periods[0].label
    for column in range(1, columns + 1):  # the band has to cover the merged range
        sheet.cell(row=TITLE_ROW, column=column).fill = TITLE_FILL
    title = f"{REPORT_TITLE}  |  {span}  |  {currency}  |  {format_percentage(percentage)}%"
    cell = sheet.cell(row=TITLE_ROW, column=1, value=title)
    cell.font = TITLE_FONT
    cell.alignment = Alignment(horizontal="center", vertical="center")
    merge_to = min(text_columns or columns, columns)
    if merge_to > 1:
        sheet.merge_cells(
            start_row=TITLE_ROW, start_column=1, end_row=TITLE_ROW, end_column=merge_to
        )
    sheet.row_dimensions[TITLE_ROW].height = 34


def chart_column_span(sheet, first_column: int) -> int:
    """How many columns a chart anchored at ``first_column`` covers, at their widths."""
    remaining, span = CHART_WIDTH_CM, 0
    while remaining > 0:
        dimension = sheet.column_dimensions.get(get_column_letter(first_column + span))
        width = dimension.width if dimension and dimension.width else DEFAULT_COLUMN_WIDTH
        remaining -= (7 * width + 5) / PIXELS_PER_CM
        span += 1
    return span


def build_chart_title(text: str) -> Title:
    """Chart title, larger than the Excel default and above the plot area, not over it."""
    font = CharacterProperties(sz=CHART_TITLE_SIZE, b=True, solidFill=CHART_TITLE_COLOR)
    paragraph = Paragraph(
        pPr=ParagraphProperties(defRPr=font), r=[RegularTextRun(t=text, rPr=font)]
    )
    return Title(tx=Text(rich=RichText(p=[paragraph])), overlay=False)


def add_left_rule(cell, side: Side) -> None:
    """Vertical rule on the left of a cell, keeping the borders it already carries."""
    cell.border = Border(
        left=side, right=cell.border.right, top=cell.border.top, bottom=cell.border.bottom
    )


def style_header(
    sheet,
    columns: int,
    row: int = HEADER_ROW,
    fill: PatternFill = HEADER_FILL,
    wrap: bool = True,
    height: int = HEADER_HEIGHT,
    rule: bool = True,
) -> None:
    for column in range(1, columns + 1):
        cell = sheet.cell(row=row, column=column)
        cell.fill = fill
        cell.font = HEADER_FONT
        if rule:  # the rule closes the header block, so only its last row gets it
            cell.border = HEADER_BORDER
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=wrap)
    sheet.row_dimensions[row].height = height


def fit_width(text: str, minimum: int) -> float:
    """Column width that fits a bold 12pt header label without wrapping it."""
    return max(minimum, len(text) * 1.25 + 3)


def style_total_row(sheet, columns: int) -> None:
    """Bold, filled and ruled off from the rows above: the total row of a table."""
    for column in range(1, columns + 1):
        cell = sheet.cell(row=sheet.max_row, column=column)
        cell.font = TOTAL_FONT
        cell.fill = TOTAL_FILL
        cell.border = TOTAL_BORDER
    sheet.row_dimensions[sheet.max_row].height = 20


def set_widths(sheet, widths: list[int]) -> None:
    for index, width in enumerate(widths, start=1):
        sheet.column_dimensions[get_column_letter(index)].width = width


def period_total(rows: list[OrganizationRow], amounts: str, period: Period) -> Decimal:
    """Sum one of the amount mappings of every organization for a single period."""
    key = str(period)
    return sum((getattr(row, amounts).get(key, Decimal("0")) for row in rows), Decimal("0"))


def type_period_total(rows: list[OrganizationRow], datasource_type: str, period: Period) -> Decimal:
    """Spend in EUR of a single datasource type over every organization, for one period."""
    key = str(period)
    return sum(
        (
            row.spend_converted_by_type.get(key, {}).get(datasource_type, Decimal("0"))
            for row in rows
        ),
        Decimal("0"),
    )


def present_datasource_types(rows: list[OrganizationRow]) -> list[str]:
    """The datasource types with expenses, known ones first, in report order."""
    present = {datasource_type for row in rows for datasource_type in row.datasource_types}
    known = [datasource_type for datasource_type in DATASOURCE_TYPES if datasource_type in present]
    return known + sorted(present - set(DATASOURCE_TYPES))


def add_monthly_chart(
    sheet,
    title: str,
    columns: list[int],
    periods: list[Period],
    colors: list[str],
    currency: str,
    bars: bool = False,
) -> BarChart | LineChart:
    """
    One measure over the reported periods as a line, a breakdown as clustered columns.

    Clustered columns compare the series month by month; they are not stacked, so the
    bars of a month do not add up to its total by eye.
    """
    chart = BarChart() if bars else LineChart()
    if bars:
        chart.type = "col"
        chart.grouping = "clustered"
        chart.overlap = 0  # the columns of a month touch without overlapping
        chart.gapWidth = 60
    else:
        chart.grouping = "standard"
    chart.title = build_chart_title(title)
    chart.y_axis.title = currency
    chart.y_axis.numFmt = AXIS_FORMAT  # thousands, the cents belong in the table
    chart.x_axis.delete = False  # openpyxl defaults would hide the axes in Excel
    chart.y_axis.delete = False
    chart.height = CHART_HEIGHT_CM
    chart.width = CHART_WIDTH_CM
    last_row = HEADER_ROW + len(periods)
    for column in columns:
        chart.add_data(
            Reference(sheet, min_col=column, min_row=HEADER_ROW, max_row=last_row),
            titles_from_data=True,
        )
    chart.set_categories(Reference(sheet, min_col=1, min_row=FIRST_DATA_ROW, max_row=last_row))
    for series, color in zip(chart.series, colors):
        if bars:
            series.graphicalProperties.solidFill = color
            series.graphicalProperties.line.solidFill = "FFFFFF"  # a gap between the columns
            series.graphicalProperties.line.width = SEGMENT_EDGE_EMU
            continue
        series.graphicalProperties.line.solidFill = color
        series.graphicalProperties.line.width = LINE_WIDTH_EMU
        series.marker = Marker(
            symbol="circle", size=7, spPr=GraphicalProperties(solidFill=color, ln=None)
        )
        series.smooth = False
    if len(columns) < 2:
        chart.legend = None  # one series, the title names it
    else:
        chart.legend.position = "b"
        chart.legend.overlay = False
    return chart


def write_summary_sheet(
    sheet,
    periods: list[Period],
    rows: list[OrganizationRow],
    percentage: Decimal,
    currency: str,
) -> None:
    """
    Monthly totals: spending and billed amount, broken down per datasource type.

    Layout: month | spending per type... | total spending | billed per type... | total billed.
    """
    types = present_datasource_types(rows)
    billed_label = "billed"
    headers = ["Month"]
    headers += [f"{datasource_label(t)}" for t in types]
    headers.append("Total")
    headers += [f"{datasource_label(t)} {billed_label}" for t in types]
    headers.append(f"Total {billed_label}")

    # the charts sit one column to the right of the table: the title band covers both
    chart_column = len(headers) + 2
    set_widths(sheet, [16] + [20] * (len(headers) - 1))
    chart_span = chart_column_span(sheet, chart_column)
    write_title(sheet, chart_column + chart_span - 1, periods, currency, percentage)
    sheet.append(headers)
    style_header(sheet, len(headers))

    factor = percentage / Decimal(100)
    for period in periods:
        spend_by_type = [
            type_period_total(rows, datasource_type, period) for datasource_type in types
        ]
        values: list[Any] = [period.label]
        values += [money(spend) for spend in spend_by_type]
        values.append(money(period_total(rows, "spend_converted", period)))
        values += [money(spend * factor) for spend in spend_by_type]
        values.append(money(period_total(rows, "billed", period)))
        sheet.append(values)

    total_spend_by_type = [
        sum((type_period_total(rows, datasource_type, period) for period in periods), Decimal("0"))
        for datasource_type in types
    ]
    totals: list[Any] = ["TOTAL"]
    totals += [money(spend) for spend in total_spend_by_type]
    totals.append(money(sum((row.total_spend_converted for row in rows), Decimal("0"))))
    totals += [money(spend * factor) for spend in total_spend_by_type]
    totals.append(money(sum((row.total_billed for row in rows), Decimal("0"))))
    sheet.append(totals)
    style_total_row(sheet, len(headers))

    for excel_row in sheet.iter_rows(min_row=FIRST_DATA_ROW, min_col=2):
        for cell in excel_row:
            cell.number_format = MONEY_FORMAT
    for excel_row in sheet.iter_rows(min_row=FIRST_DATA_ROW, max_col=1):
        for cell in excel_row:
            cell.font = Font(bold=True)

    # rows only: freezing the month column would tear the title band while scrolling
    sheet.freeze_panes = sheet.cell(row=FIRST_DATA_ROW, column=1).coordinate

    total_billed_column = len(headers)
    anchor_column = get_column_letter(chart_column)
    sheet.add_chart(
        add_monthly_chart(
            sheet, "Billed per month", [total_billed_column], periods, [TOTAL_COLOR], currency
        ),
        f"{anchor_column}{HEADER_ROW + 2}",
    )
    if len(types) > 1:  # with a single datasource type the chart above says it all
        first_billed_column = 2 + len(types) + 1
        sheet.add_chart(
            add_monthly_chart(
                sheet,
                "Billed per month by datasource type",
                list(range(first_billed_column, first_billed_column + len(types))),
                periods,
                DATASOURCE_COLORS,
                currency,
                bars=True,
            ),
            f"{anchor_column}{HEADER_ROW + 19}",
        )


def write_workbook(
    path: Path,
    periods: list[Period],
    rows: list[OrganizationRow],
    percentage: Decimal,
    rates: dict[str, Decimal],
    skipped: int,
    currency: str,
) -> None:
    workbook = Workbook()
    sheet = workbook.active
    sheet.title = "Billing"

    # (label, minimum width) of the columns describing the organization and its totals,
    # spanning both header rows
    leading = [
        ("ID", 18),
        ("Name", 46),
        ("Operations External ID", 24),
        (f"Rate to {currency}", 14),
        ("Total", 20),
        ("Billed", 20),
    ]
    # the three columns repeated for every month, under the month name. The spend in the
    # organization currency carries its code in the cell format, so it needs no column
    monthly = ["Original", "Spending", "Billed"]
    columns = len(leading) + 3 * len(periods)
    group_row, label_row = HEADER_ROW, HEADER_ROW + 1
    first_data_row = label_row + 1

    # the leading columns are frozen: merging the title over them only keeps it still
    write_title(sheet, columns, periods, currency, percentage, text_columns=len(leading))
    for index, (label, _) in enumerate(leading, start=1):
        sheet.cell(row=group_row, column=index, value=label)
        sheet.merge_cells(
            start_row=group_row, start_column=index, end_row=label_row, end_column=index
        )
    column = len(leading) + 1
    for period in periods:
        sheet.cell(row=group_row, column=column, value=period.label)
        sheet.merge_cells(
            start_row=group_row, start_column=column, end_row=group_row, end_column=column + 2
        )
        for offset, label in enumerate(monthly):
            sheet.cell(row=label_row, column=column + offset, value=label)
        column += 3
    style_header(sheet, columns, row=group_row, wrap=False, height=24, rule=False)
    style_header(sheet, columns, row=label_row, fill=SUBHEADER_FILL, wrap=False, height=24)

    for row in rows:  # already sorted from the most to the least billed
        values: list[Any] = [
            row.organization_id,
            row.name,
            row.operations_external_id,
            float(row.exchange_rate),
            money(row.total_spend_converted),
            money(row.total_billed),
        ]
        for period in periods:
            key = str(period)
            values.append(money(row.spend.get(key, Decimal("0"))))
            values.append(money(row.spend_converted.get(key, Decimal("0"))))
            values.append(money(row.billed.get(key, Decimal("0"))))
        sheet.append(values)

    if rows:
        totals: list[Any] = ["", "TOTAL", "", ""]
        totals.append(money(sum((row.total_spend_converted for row in rows), Decimal("0"))))
        totals.append(money(sum((row.total_billed for row in rows), Decimal("0"))))
        for period in periods:
            totals.append(None)  # spend in mixed currencies cannot be summed
            totals.append(money(period_total(rows, "spend_converted", period)))
            totals.append(money(period_total(rows, "billed", period)))
        sheet.append(totals)
        style_total_row(sheet, columns)

    for excel_row in sheet.iter_rows(min_row=first_data_row, min_col=FIRST_MONEY_COLUMN):
        for cell in excel_row:
            cell.number_format = MONEY_FORMAT
    for excel_row in sheet.iter_rows(
        min_row=first_data_row, min_col=RATE_COLUMN, max_col=RATE_COLUMN
    ):
        for cell in excel_row:
            cell.number_format = RATE_FORMAT
    for offset, row in enumerate(rows):  # the organization currency, spelled in the cell
        original_format = f'#,##0.00 "{row.currency}"'
        for index in range(len(periods)):
            sheet.cell(
                row=first_data_row + offset, column=FIRST_PERIOD_COLUMN + 3 * index
            ).number_format = original_format
    last_data_row = label_row + len(rows)
    for excel_row in sheet.iter_rows(  # the range totals are the columns to read first
        min_row=first_data_row,
        max_row=last_data_row,
        min_col=FIRST_MONEY_COLUMN,
        max_col=FIRST_PERIOD_COLUMN - 1,
    ):
        for cell in excel_row:
            cell.fill = EMPHASIS_FILL
            cell.font = Font(bold=True)

    for index in range(len(periods)):  # tell the months apart: a rule and a light tint
        first_column = FIRST_PERIOD_COLUMN + 3 * index
        for excel_row in range(group_row, sheet.max_row + 1):
            add_left_rule(
                sheet.cell(row=excel_row, column=first_column),
                MONTH_HEADER_RULE if excel_row <= label_row else MONTH_RULE,
            )
        if index % 2:
            for excel_row in sheet.iter_rows(
                min_row=first_data_row,
                max_row=last_data_row,
                min_col=first_column,
                max_col=first_column + 2,
            ):
                for cell in excel_row:
                    cell.fill = MONTH_FILL

    set_widths(
        sheet,
        [fit_width(label, minimum) for label, minimum in leading]
        + [fit_width(label, 14) for label in monthly] * len(periods),
    )
    sheet.freeze_panes = sheet.cell(row=first_data_row, column=FIRST_PERIOD_COLUMN).coordinate
    sheet.auto_filter.ref = f"A{label_row}:{get_column_letter(columns)}{last_data_row}"

    write_summary_sheet(workbook.create_sheet("Summary", 0), periods, rows, percentage, currency)

    info_sheet = workbook.create_sheet("Run Info")
    write_title(info_sheet, 2, periods, currency, percentage)
    info_sheet.append(["Key", "Value"])
    style_header(info_sheet, 2)
    info: list[tuple[str, str]] = [
        ("Generated at (UTC)", datetime.now(UTC).strftime("%Y-%m-%d %H:%M:%S")),
        ("Periods", ", ".join(str(period) for period in periods)),
        ("Billed percentage", f"{format_percentage(percentage)}%"),
        ("Target currency", currency),
        ("Organizations", str(len(rows))),
        ("Excluded organizations", f"{skipped} with no expenses in the reported months"),
        ("Trials and entitlements", "not taken into account"),
        (
            "Exchange rates",
            "latest rates at generation time, applied to every period "
            "(the rates service exposes no historical data)",
        ),
    ]
    for key, value in info:
        info_sheet.append([key, value])
    info_sheet.append(["", ""])
    info_sheet.append(["Currency", f"Rate to {currency}"])
    for source_currency, rate in sorted(rates.items()):
        info_sheet.append([source_currency, str(rate)])
    set_widths(info_sheet, [30, 100])
    for excel_row in info_sheet.iter_rows(min_row=FIRST_DATA_ROW, min_col=2, max_col=2):
        for cell in excel_row:
            cell.alignment = Alignment(wrap_text=True, vertical="top")
    for excel_row in info_sheet.iter_rows(min_row=FIRST_DATA_ROW, max_col=1):
        for cell in excel_row:
            cell.font = Font(bold=True)

    workbook.save(path)


def build_monthly_table(
    periods: list[Period], rows: list[OrganizationRow], percentage: Decimal, currency: str
) -> Table:
    """Same figures as the Summary sheet: spending and billed amount per month."""
    table = Table(title=f"Monthly totals ({currency})", header_style="bold cyan")
    table.add_column("Month")
    table.add_column("Spending", justify="right")
    table.add_column(f"Billed {format_percentage(percentage)}%", justify="right", style="green")

    for period in periods:
        table.add_row(
            period.label,
            f"{money(period_total(rows, 'spend_converted', period)):,.2f}",
            f"{money(period_total(rows, 'billed', period)):,.2f}",
        )

    if rows:
        table.add_section()
        table.add_row(
            "TOTAL",
            f"{money(sum((r.total_spend_converted for r in rows), Decimal('0'))):,.2f}",
            f"{money(sum((r.total_billed for r in rows), Decimal('0'))):,.2f}",
            style="bold yellow",
        )
    return table


def build_datasource_table(
    periods: list[Period], rows: list[OrganizationRow], percentage: Decimal, currency: str
) -> Table:
    """Spending and billed amount of the whole reported range, per datasource type."""
    table = Table(title=f"Totals by datasource type ({currency})", header_style="bold cyan")
    table.add_column("Datasource type")
    table.add_column("Spending", justify="right")
    table.add_column(f"Billed {format_percentage(percentage)}%", justify="right", style="green")

    factor = percentage / Decimal(100)
    for datasource_type in present_datasource_types(rows):
        spend = sum(
            (type_period_total(rows, datasource_type, period) for period in periods), Decimal("0")
        )
        table.add_row(
            datasource_label(datasource_type),
            f"{money(spend):,.2f}",
            f"{money(spend * factor):,.2f}",
        )

    if rows:
        table.add_section()
        table.add_row(
            "TOTAL",
            f"{money(sum((r.total_spend_converted for r in rows), Decimal('0'))):,.2f}",
            f"{money(sum((r.total_billed for r in rows), Decimal('0'))):,.2f}",
            style="bold yellow",
        )
    return table


def print_summary(
    periods: list[Period], rows: list[OrganizationRow], percentage: Decimal, currency: str
) -> None:
    table = Table(
        title=(
            "Top 15 organizations by billed amount "
            f"({format_percentage(percentage)}% of spend, {currency})"
        ),
        header_style="bold cyan",
    )
    table.add_column("Name", overflow="fold")
    table.add_column("Ccy", justify="center")
    table.add_column("Rate", justify="right")
    table.add_column("Total spend", justify="right")
    table.add_column("Total billed", justify="right", style="bold green")
    for period in periods:
        table.add_column(f"{period.label} spend", justify="right")
        table.add_column(f"{period.label} billed", justify="right", style="green")

    for row in rows[:15]:
        cells = [
            row.name,
            row.currency,
            f"{row.exchange_rate:f}",
            f"{money(row.total_spend_converted):,.2f}",
            f"{money(row.total_billed):,.2f}",
        ]
        for period in periods:
            cells.append(f"{money(row.spend_converted.get(str(period), Decimal('0'))):,.2f}")
            cells.append(f"{money(row.billed.get(str(period), Decimal('0'))):,.2f}")
        table.add_row(*cells)

    if rows:
        totals = [
            "TOTAL",
            "",
            "",
            f"{money(sum((r.total_spend_converted for r in rows), Decimal('0'))):,.2f}",
            f"{money(sum((r.total_billed for r in rows), Decimal('0'))):,.2f}",
        ]
        for period in periods:
            totals.append(f"{money(period_total(rows, 'spend_converted', period)):,.2f}")
            totals.append(f"{money(period_total(rows, 'billed', period)):,.2f}")
        table.add_section()
        table.add_row(*totals, style="bold yellow")

    console.print(table)
    console.print(build_monthly_table(periods, rows, percentage, currency))
    console.print(build_datasource_table(periods, rows, percentage, currency))


