@dataclass(frozen=True)
class Period:
    year: int
    month: int

    @property
    def label(self) -> str:
        return datetime(self.year, self.month, 1).strftime("%b %Y")

    def __str__(self) -> str:
        return f"{self.year:04d}-{self.month:02d}"


def build_periods(year: int, month: int, months: int) -> list[Period]:
    """Return ``months`` periods, oldest first, ending with ``year``/``month``."""
    anchor = date(year, month, 1)
    return [
        Period(period.year, period.month)
        for period in (anchor - relativedelta(months=offset) for offset in reversed(range(months)))
    ]


