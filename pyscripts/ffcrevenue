def env(name: str) -> str:
    """Read a secret, accepting both the plain and the ``EXT_`` prefixed name."""
    for key in (name, f"EXT_{name}"):
        value = os.environ.get(key)
        if value:
            return value
    raise typer.BadParameter(f"environment variable {name} (or EXT_{name}) is not set")


def money(value: Decimal) -> float:
    return float(value.quantize(CENTS, rounding=ROUND_HALF_UP))


def describe_error(error: BaseException) -> str:
    """Flatten the exception group raised by the task group down to the first failure."""
    while isinstance(error, BaseExceptionGroup) and error.exceptions:
        error = error.exceptions[0]
    return f"{type(error).__name__}: {error}"


def format_percentage(percentage: Decimal) -> str:
    """5.0 -> '5', 2.50 -> '2.5'."""
    return f"{percentage:f}".rstrip("0").rstrip(".") or "0"


def datasource_label(datasource_type: str) -> str:
    """'azure_cnr' -> 'Azure'; unknown types keep the raw value."""
    return DATASOURCE_TYPES.get(datasource_type, datasource_type)


