def build_httpx_client(base_url: str, auth: httpx.Auth | None) -> httpx.AsyncClient:
    return httpx.AsyncClient(
        base_url=base_url,
        auth=auth,
        timeout=httpx.Timeout(connect=10.0, read=180.0, write=10.0, pool=60.0),
        # a failed request aborts the whole report, so insist before giving up
        transport=RetryTransport(
            retry=Retry(
                total=10,
                backoff_factor=1.0,
                max_backoff_wait=60.0,
                status_forcelist=[408, 425, 429, 500, 502, 503, 504],
            )
        ),
    )


class FFCOpsAuth(httpx.Auth):
    """Short lived JWT, regenerated when the API answers 401."""

    requires_response_body = True

    def __init__(self, sub: str, secret: str):
        self.sub = sub
        self.secret = secret
        self.jwt_token = self.generate_jwt_token()

    def generate_jwt_token(self) -> str:
        now = datetime.now(UTC)
        return jwt.encode(
            {"sub": self.sub, "exp": now + timedelta(minutes=5), "nbf": now, "iat": now},
            self.secret,
            algorithm="HS256",
        )

    async def async_auth_flow(
        self, request: httpx.Request
    ) -> AsyncGenerator[httpx.Request, httpx.Response]:
        request.headers["Authorization"] = f"Bearer {self.jwt_token}"
        response = yield request
        if response.status_code == 401:
            self.jwt_token = self.generate_jwt_token()
            request.headers["Authorization"] = f"Bearer {self.jwt_token}"
            yield request


class FFCClient:
    """Minimal async client for the FinOps for Cloud operations API."""

    def __init__(self, base_url: str, sub: str, secret: str, page_size: int = 100):
        self.page_size = page_size
        self.client = build_httpx_client(base_url, FFCOpsAuth(sub, secret))

    async def close(self) -> None:
        await self.client.aclose()

    async def _iterate(self, endpoint: str, rql: str = "") -> AsyncGenerator[dict[str, Any], None]:
        offset = 0
        while True:
            response = await self.client.get(
                f"{endpoint}?{rql}&limit={self.page_size}&offset={offset}"
            )
            response.raise_for_status()
            payload = response.json()
            for item in payload["items"]:
                yield item
            if payload["total"] <= self.page_size + offset:
                break
            offset += self.page_size

    def fetch_organizations(self) -> AsyncGenerator[dict[str, Any], None]:
        return self._iterate("/organizations")

    def fetch_expenses(
        self, organization_id: str, period: Period
    ) -> AsyncGenerator[dict[str, Any], None]:
        rql = (
            "and("
            f"eq(organization.id,{organization_id}),"
            f"eq(year,{period.year}),"
            f"eq(month,{period.month}),"
            "eq(events.deleted.at,null())"
            ")"
            "&order_by(linked_datasource_id)"
        )
        return self._iterate("/expenses", rql)


class ExchangeRatesClient:
    """Fetches and caches the conversion rates towards the target currency."""

    def __init__(self, base_url: str, token: str, target_currency: str):
        self.token = token
        self.target_currency = target_currency
        self.client = build_httpx_client(base_url, None)
        self._cache: dict[str, Decimal] = {target_currency: Decimal("1")}
        self._tasks: dict[str, asyncio.Task[Decimal]] = {}
        self._lock = asyncio.Lock()

    async def close(self) -> None:
        await self.client.aclose()

    async def _fetch_rate(self, currency: str) -> Decimal:
        response = await self.client.get(f"{self.token}/latest/{currency}")
        response.raise_for_status()
        rates = response.json().get("conversion_rates") or {}
        if self.target_currency not in rates:
            raise RuntimeError(
                f"no {self.target_currency} conversion rate available for {currency}"
            )
        rate = Decimal(str(rates[self.target_currency])).quantize(RATE_PRECISION)
        self._cache[currency] = rate
        return rate

    async def rate_to_target(self, currency: str) -> Decimal:
        """One request per currency, shared by every organization using it."""
        if currency in self._cache:
            return self._cache[currency]
        async with self._lock:
            task = self._tasks.get(currency)
            if task is None:
                task = asyncio.create_task(self._fetch_rate(currency))
                self._tasks[currency] = task
        return await task

    @property
    def used_rates(self) -> dict[str, Decimal]:
        return dict(self._cache)


