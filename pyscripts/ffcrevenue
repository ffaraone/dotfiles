@dataclass
class OrganizationRow:
    organization_id: str
    name: str
    operations_external_id: str
    currency: str
    exchange_rate: Decimal = Decimal("1")
    # str(period) -> monthly spend in the organization data currency
    spend: dict[str, Decimal] = field(default_factory=dict)
    # str(period) -> monthly spend in EUR
    spend_converted: dict[str, Decimal] = field(default_factory=dict)
    # str(period) -> billed amount in EUR
    billed: dict[str, Decimal] = field(default_factory=dict)
    # str(period) -> datasource type -> monthly spend in EUR
    spend_converted_by_type: dict[str, dict[str, Decimal]] = field(default_factory=dict)

    @property
    def total_spend_converted(self) -> Decimal:
        return sum(self.spend_converted.values(), Decimal("0"))

    @property
    def total_billed(self) -> Decimal:
        return sum(self.billed.values(), Decimal("0"))

    @property
    def datasource_types(self) -> set[str]:
        return {
            datasource_type
            for by_type in self.spend_converted_by_type.values()
            for datasource_type in by_type
        }


class ReportBuilder:
    def __init__(
        self,
        ffc: FFCClient,
        rates: ExchangeRatesClient,
        periods: list[Period],
        percentage: Decimal,
        concurrency: int,
    ):
        self.ffc = ffc
        self.rates = rates
        self.periods = periods
        self.percentage = percentage
        self.semaphore = asyncio.Semaphore(concurrency)
        self.rows: list[OrganizationRow] = []
        self.skipped = 0  # organizations with no expenses in any of the reported months

    async def close(self) -> None:
        await asyncio.gather(self.ffc.close(), self.rates.close())

    async def monthly_expenses(self, organization_id: str, period: Period) -> dict[str, Decimal]:
        """
        Spend of the month per datasource type, in the organization data currency.

        The expenses endpoint returns, per datasource, the cumulative spend at each day
        of the month, so the monthly total of a datasource is its value on the last day
        it reported.
        """
        latest_by_datasource: dict[str, tuple[int, str, Decimal]] = {}
        async for row in self.ffc.fetch_expenses(organization_id, period):
            linked_datasource_id = row["linked_datasource_id"]
            day = int(row["day"])
            known_day, _, _ = latest_by_datasource.get(linked_datasource_id, (-1, "", Decimal("0")))
            if day > known_day:
                latest_by_datasource[linked_datasource_id] = (
                    day,
                    row.get("linked_datasource_type") or "unknown",
                    Decimal(str(row["total_expenses"])),
                )
        by_type: dict[str, Decimal] = {}
        for _, datasource_type, amount in latest_by_datasource.values():
            by_type[datasource_type] = by_type.get(datasource_type, Decimal("0")) + amount
        return by_type

    async def process_organization(self, organization: dict[str, Any]) -> None:
        async with self.semaphore:
            currency = organization["currency"]
            row = OrganizationRow(
                organization_id=organization["id"],
                name=organization.get("name") or "",
                operations_external_id=organization.get("operations_external_id") or "",
                currency=currency,
                exchange_rate=await self.rates.rate_to_target(currency),
            )
            for period in self.periods:
                by_type = await self.monthly_expenses(row.organization_id, period)
                spend = sum(by_type.values(), Decimal("0"))
                spend_converted = spend * row.exchange_rate
                row.spend[str(period)] = spend
                row.spend_converted[str(period)] = spend_converted
                row.billed[str(period)] = spend_converted * self.percentage / Decimal(100)
                row.spend_converted_by_type[str(period)] = {
                    datasource_type: amount * row.exchange_rate
                    for datasource_type, amount in by_type.items()
                    if amount
                }
            if not row.total_spend_converted:  # nothing to bill in any of the reported months
                self.skipped += 1
                return
            self.rows.append(row)

    async def run(self, organization_ids: list[str] | None) -> None:
        with console.status("[cyan]fetching organizations..."):
            organizations = [organization async for organization in self.ffc.fetch_organizations()]
        if organization_ids:
            wanted = set(organization_ids)
            organizations = [o for o in organizations if o["id"] in wanted]

        with Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            BarColumn(),
            MofNCompleteColumn(),
            TimeElapsedColumn(),
            console=console,
        ) as progress:
            task = progress.add_task("computing billed amounts", total=len(organizations))

            async def worker(organization: dict[str, Any]) -> None:
                await self.process_organization(organization)
                progress.advance(task)

            # any failure aborts the report: partial data would be wrong data
            async with asyncio.TaskGroup() as group:
                for organization in organizations:
                    group.create_task(worker(organization))

        self.rows.sort(key=lambda row: row.total_billed, reverse=True)
        if self.skipped:
            console.print(
                f"[dim]{self.skipped} organization(s) without expenses in the reported "
                "months excluded"
            )


