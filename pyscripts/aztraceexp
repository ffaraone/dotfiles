            child_btn = f'<span class="child-toggle" onclick="event.stopPropagation(); toggleChildren(this)">▶</span>'
        else:
            child_btn = '<span class="child-toggle placeholder"></span>'

        # Type badge
        type_badge = f'<span class="badge badge-type">{span.span_type}</span>' if span.span_type else ""

        # Result code badge (red if not 2xx/success)
        if span.result_code:
            rc = str(span.result_code)
            rc_cls = "badge-error" if (not span.success or rc.startswith(("4", "5"))) else "badge-code"
            code_badge = f'<span class="badge {rc_cls}">{rc}</span>'
        else:
            code_badge = ""

        dur = f'<span class="dur">{fmt_duration(span.duration_ms)}</span>'
        ts_span = f'<span class="ts">{ts}</span>' if ts else ""

        # Detail rows
        detail_rows = []
        if span.span_id:
            detail_rows.append(("Span ID", span.span_id))
        if span.operation_id:
            detail_rows.append(("Operation ID", span.operation_id))
        if span.parent_id:
            detail_rows.append(("Parent ID", span.parent_id))
        if ts:
            detail_rows.append(("Timestamp", ts))
        detail_rows.append(("Duration", f"{fmt_duration(span.duration_ms)} ({span.duration_ms:.3f} ms)"))
        if span.span_type:
            detail_rows.append(("Type", span.span_type))
        if span.dependency_type:
            detail_rows.append(("Dependency Type", span.dependency_type))
        if span.result_code:
            detail_rows.append(("Result Code", span.result_code))
        if span.message:
            detail_rows.append(("Message", span.message))

        detail_html = "".join(
            f'<div class="detail-row"><span class="detail-key">{k}</span><span class="detail-val">{v}</span></div>'
            for k, v in detail_rows
        )

        children_html = ""
        if span.children:
            children_html = f'<div class="children">{_render_spans_html(span.children)}</div>'

        parts.append(f"""<div class="tree-node">
  <div class="span-row{failure_class}" onclick="toggleDetail(this)">
    {child_btn}
    <span class="status-icon">{icon}</span>
    <span class="span-name">{span.span_name}</span>
    <span class="span-meta">{type_badge}{code_badge}{dur}{ts_span}</span>
    <span class="detail-arrow">▼</span>
  </div>
  <div class="span-detail">{detail_html}</div>
  {children_html}
</div>""")

    return "\n".join(parts)


def filename_for(base: str, output_dir: Optional[Path] = None) -> Path:
    """Generate a unique filename for output"""
    today = datetime.now().strftime("%Y%m%d")
    if output_dir is None:
        output_dir = Path(".")
    else:
        output_dir = Path(output_dir)

    output_dir.mkdir(parents=True, exist_ok=True)
    base_name = f"{base}_{today}.html"
    p = output_dir / base_name

    if not p.exists():
        return p

    counter = 1
    while True:
        p2 = output_dir / f"{base}_{today}_{counter}.html"
        if not p2.exists():
            return p2
        counter += 1


# ── Shared config (~/.config/aztools/config.json) ──

def _config_dir() -> Path:
    return Path.home() / ".config" / "aztools"


def _config_file() -> Path:
    return _config_dir() / "config.json"


def load_config() -> dict:
    p = _config_file()
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_config(cfg: dict) -> None:
    d = _config_dir()
    d.mkdir(parents=True, exist_ok=True)
    _config_file().write_text(json.dumps(cfg, indent=2), encoding="utf-8")


config_app = typer.Typer(help="Manage saved workspace ids (prod/dev/test/stage)")


@config_app.command("set")
def config_set(
    prod: Optional[str] = typer.Option(None, "--prod", help="Set prod workspace id"),
    dev: Optional[str] = typer.Option(None, "--dev", help="Set dev workspace id"),
    test: Optional[str] = typer.Option(None, "--test", help="Set test workspace id"),
    stage: Optional[str] = typer.Option(None, "--stage", help="Set stage workspace id"),
) -> None:
    """Set saved workspace ids in ~/.config/aztools/config.json"""
    cfg = load_config()
    changed = False
    for env, value in [("prod", prod), ("dev", dev), ("test", test), ("stage", stage)]:
        if value:
            cfg[env] = value
            changed = True
    if changed:
        save_config(cfg)
        console.print("[green]Configuration updated.[/green]")
    else:
        console.print("No changes. Use --prod/--dev/--test/--stage to set values.")


@config_app.command("show")
def config_show() -> None:
    """Show saved workspace ids"""
    from rich import box
    from rich.table import Table

    cfg = load_config()
    if not cfg:
        console.print("[yellow]No workspaces configured.[/yellow]")
        return
    table = Table(title="Saved Workspaces", box=box.ROUNDED, border_style="blue", header_style="bold cyan")
    table.add_column("Environment", style="cyan", no_wrap=True)
    table.add_column("Workspace ID", style="white")
    for env in ("prod", "stage", "dev", "test"):
        if wid := cfg.get(env):
            table.add_row(env, wid)
    for k in sorted(cfg):
        if k not in ("prod", "stage", "dev", "test"):
            table.add_row(k, str(cfg[k]))
    console.print(table)


app.add_typer(config_app, name="config")


@app.callback(invoke_without_command=True)
def main(
    ctx: typer.Context,
    workspace_id: Optional[str] = typer.Option(
        None,
        "--workspace-id",
        "-w",
        help="Azure Log Analytics Workspace ID (overrides config/env)",
        envvar="AZURE_WORKSPACE_ID",
    ),
    operation_id: Optional[str] = typer.Option(
        None,
        "--operation-id",
        "-o",
        help="Operation ID to fetch traces for",
    ),
    trace_id: Optional[str] = typer.Option(
        None,
        "--trace-id",
        "-t",
        help="Trace ID to fetch spans for",
    ),
    minutes_back: int = typer.Option(
        60,
        "--minutes-back",
        "-m",
        help="How many minutes back to search (default: 60)",
    ),
    output_dir: Optional[Path] = typer.Option(
        None,
        "--output-dir",
        "-d",
        help="Directory to save the HTML file",
    ),
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Enable debug mode to see queries and raw results",
    ),
    prod: bool = typer.Option(False, "--prod", help="Use prod workspace from config"),
    dev: bool = typer.Option(False, "--dev", help="Use dev workspace from config"),
    test: bool = typer.Option(False, "--test", help="Use test workspace from config"),
    stage: bool = typer.Option(False, "--stage", help="Use stage workspace from config"),
) -> None:
    """
    Export traces from Azure Application Insights to an interactive HTML treeview.

    Workspace can be set via --workspace-id, AZURE_WORKSPACE_ID env var,
    or configured with: aztraceexp config set --prod <id>
    """
    if ctx.invoked_subcommand is not None:
        return

    # Resolve workspace from shared config if not explicitly provided
    if not workspace_id:
        if sum([prod, dev, test, stage]) > 1:
            console.print("[red]Error: Only one of --prod, --dev, --test, --stage can be used[/red]")
            raise typer.Exit(code=1)
        cfg = load_config()
        env = "dev" if dev else "test" if test else "stage" if stage else "prod"
        workspace_id = cfg.get(env)
        if not workspace_id:
            console.print(
                f"[red]Error: No workspace configured for '{env}'.[/red]\n"
                f"Run: aztraceexp config set --{env} <workspace-id>"
            )
            raise typer.Exit(code=1)

    if not operation_id and not trace_id:
        console.print("[red]Error: Must provide either --operation-id or --trace-id[/red]")
        raise typer.Exit(code=1)

    with console.status("[bold green]Connecting to Azure..."):
        client = get_logs_client(workspace_id)

    with console.status("[bold green]Querying Application Insights..."):
        rows = query_traces(
            client,
            workspace_id,
            operation_id=operation_id,
            trace_id=trace_id,
            minutes_back=minutes_back,
            debug=debug,
        )

    if not rows:
        console.print("[yellow]No traces found matching the criteria[/yellow]")
        raise typer.Exit(code=0)

    console.print(f"[green]✓[/green] Found {len(rows)} spans")

    with console.status("[bold green]Processing spans..."):
        spans = parse_spans(rows)
        root_spans = build_span_tree(spans)

    search_id = operation_id or trace_id
    outpath = filename_for(f"trace_{search_id}", output_dir=output_dir)

    with console.status("[bold green]Generating HTML..."):
        generate_html(root_spans, search_id, outpath)

    console.print(f"[green]✓[/green] Wrote trace export to {outpath}")
    console.print(f"[blue]Open in browser:[/blue] file://{outpath.absolute()}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "config":
        sys.argv.pop(1)
