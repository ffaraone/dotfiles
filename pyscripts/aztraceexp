def _all_spans(spans: List[Span]) -> List[Span]:
    """Recursively get all spans including children"""
    all_spans = []
    for span in spans:
        all_spans.append(span)
        all_spans.extend(_all_spans(span.children))
    return all_spans


def span_icon(span: "Span") -> str:
    """Return an emoji icon that describes what the span does."""
    stype = (span.span_type or "").lower()
    dep = (span.dependency_type or "").lower()
    name = (span.span_name or "").lower()
    msg = (span.message or "").lower()

    # Exceptions and traces first
    if stype == "appexceptions":
        return "💥"
    if stype == "apptraces":
        return "📝"

    # Incoming HTTP request (server side)
    if stype == "apprequests":
        return "🌐"

    # From here on it's AppDependencies — classify by DependencyType / name
    # --- Message brokers ---
    broker_keywords = ("servicebus", "service bus", "eventhub", "event hub",
                       "rabbitmq", "rabbit", "kafka", "amqp", "sns", "sqs",
                       "pubsub", "nats")
    if any(k in dep or k in name or k in msg for k in broker_keywords):
        # Distinguish producer vs consumer by name hints
        if any(k in name for k in ("send", "publish", "produc", "enqueue", "emit")):
            return "📤"
        if any(k in name for k in ("receive", "consum", "subscri", "listen", "dequeue", "process")):
            return "📥"
        return "📨"

    # --- Databases --- check dep/name/msg for each engine first, then fall back to SQL heuristics
    if any(k in dep or k in name or k in msg for k in ("mysql",)):
        return "🐬"
    if any(k in dep or k in name or k in msg for k in ("postgres", "postgresql", " pg ")):
        return "🐘"
    if any(k in dep or k in name or k in msg for k in ("mongo",)):
        return "🍃"
    if any(k in dep or k in name or k in msg for k in ("redis",)):
        return "🔴"
    if any(k in dep or k in name or k in msg for k in ("cosmos", "cosmosdb")):
        return "🪐"
    if any(k in dep or k in name or k in msg for k in ("cassandra",)):
        return "👁️"
    if any(k in dep or k in name or k in msg for k in ("elastic", "opensearch")):
        return "🔍"
    # Generic SQL / unknown DB
    if ("sql" in dep or dep in ("sql",)
            or "sql" in name
            or any(k in msg for k in ("select ", "insert ", "update ", "delete ", "exec "))):
        return "🗄️"

    # --- Azure storage ---
    if any(k in dep or k in name for k in ("azure blob", "blob storage", "azure table", "azure storage", "azure queue")):
        return "📦"

    # --- Outbound HTTP / gRPC ---
    if dep in ("http", "https", "grpc") or any(k in dep for k in ("http",)):
        return "🔗"

    # Fallback for any remaining dependency
    if stype == "appdependencies":
        return "⚡"

    return "⬜"


def _render_spans_html(spans: List[Span]) -> str:
